# Keeps files out of the published npm package.
#
# package.json "files" is the primary filter: it allowlists dist/, src/,
# README.md and LICENSE, and its "!" entries drop env files and keys even
# inside dist/ and src/.
# npm does not let a root .npmignore remove anything "files" includes, so keep
# those "!" entries in sync with the secrets section below. This file takes
# over if "files" is ever removed.
# When a .npmignore exists, npm no longer reads .gitignore, so anything that
# must never ship has to be listed here.
# Check the result with: npm pack --dry-run

# Environment files and secrets, at any depth
.env
.env.*
*.pem
*.key
.npmrc

# Tests and the website. src/ is published: the .js.map and .d.ts.map files in
# dist/ point at ../src/*.ts, so debuggers and "Go to Definition" need it.
/tests/
/website/
/coverage/

# Repository and tooling config
/.github/
/.claude/
/.vscode/
/.idea/
/.gitignore
/.gitattributes
/tsconfig*.json
/eslint.config.js
/bun.lock
/bun.lockb
/bunfig.toml
/CLAUDE.md
/AGENTS.md

# Build and OS leftovers
node_modules/
*.tgz
*.tsbuildinfo
*.log
.DS_Store
